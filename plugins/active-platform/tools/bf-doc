#!/bin/sh
# macOS/Linux shim: bare `bf-doc` resolves here (SessionStart adds tools/ to PATH) and runs the portable DLL.
# CI must mark this file executable (chmod +x).
dll="$(dirname "$0")/bf-doc.dll"

# The plugin's hooks run through this shim. With no usable .NET runtime there is nothing to put on PATH and
# nothing to auto-approve, so a hook subcommand degrades to silence rather than reporting a launch failure
# on every Bash command of the session.
case "$1" in
    __*)
        dotnet "$dll" "$@" 2>/dev/null
        exit 0
        ;;
esac

if ! command -v dotnet >/dev/null 2>&1; then
    echo "bf-doc needs the .NET 10 runtime: https://dotnet.microsoft.com/download" >&2
    exit 1
fi

exec dotnet "$dll" "$@"
